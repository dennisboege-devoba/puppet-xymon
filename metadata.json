{
  "name": "dodevops-xymon",
  "version": "1.2.0",
  "author": "dodevops",
  "summary": "Puppet module for managing Xymon",
  "license": "MIT",
  "source": "https://github.com/dodevops/puppet-xymon",
  "project_page": "https://github.com/dodevops/puppet-xymon",
  "issues_url": "https://github.com/dodevops/puppet-xymon/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">=9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/apt",
      "version_requirement": ">=9.2.0 < 12.0.0"
    },
    {
      "name": "saz/sudo",
      "version_requirement": ">= 8.0.0 < 11.0.0"
    },
    {
      "name": "puppet/zypprepo",
      "version_requirement": ">= 6.0.0 < 7.0.0"
    },
    {
      "name": "puppetlabs/yumrepo_core",
      "version_requirement": ">=1.0.6 < 4.0.0"
    },
    {
      "name": "puppet-logrotate",
      "version_requirement": ">= 7.0.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "SLES",
      "operatingsystemrelease": [
        "15"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ]
}
